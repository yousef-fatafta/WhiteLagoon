@model VillaNumber


<div class="w-100 card border-0 p-4">
	<div class="card-header bg-success bg-gradient m-lg-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white py-2">Edit Villa</h2>
			</div>
		</div>
	</div>
</div>

<div class="card-body border p-4">
	<form asp-action="Edit" method="post" class="row">
		<input type="hidden" asp-for="VillaId" />
		<div class="form-floating py-1 col-12">
			<label asp-for="VillaId" class="form-label"></label>
			<input asp-for="VillaId" class="form-control" />
			<span asp-validation-for="VillaId" class="text-danger"></span>
		</div>
		<div class="form-floating py-1 col-12">
			<label asp-for="Villa_Number" class="form-label"></label>
			<input asp-for="Villa_Number" class="form-control" />
			<span asp-validation-for="Villa_Number" class="text-danger"></span>
		</div>
		<div class="form-floating py-1 col-12">
			<label asp-for="SpecialDetails" class="form-label"></label>
			<input asp-for="SpecialDetails" class="form-control" />
			<span asp-validation-for="SpecialDetails" class="text-danger"></span>
		</div>

		<div class="row pt-2">
			<div class="col-6 col-md-3">
				<button type="submit" class="btn btn-success w-100">
					<i class="bi bi-check-circle"></i> Edit
				</button>
			</div>

			<div class="col-6 col-md-3">
				<a asp-controller="Villa" asp-action="Index" class="btn btn-secondary w-100">
					<i class="bi bi-x-circle"></i> Cancel
				</a>
			</div>
		</div>
	</form>
</div>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
}